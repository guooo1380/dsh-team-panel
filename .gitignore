# 运行时数据（团队服务器数据文件、自测临时目录）
data/
# 直接在仓库根目录裸跑 `node lib/team-hub.mjs` 时会落到这里
/team-hub-data.json
# 自启脚本生成的启动器
scripts/_hub-autostart.cmd

# 依赖与日志
node_modules/
*.log
npm-debug.log*
pnpm-debug.log*

# 系统文件
Thumbs.db
desktop.ini
.DS_Store

# 上传 / 发布用的本地脚手架：内含 gh-token.txt 等凭据与体积很大的工具包，
# 一律不进仓库、不外发（公开仓库里出现 token 等于泄漏）。
_upload/
